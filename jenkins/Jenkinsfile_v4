pipeline {
    agent any

    environment {
        REPO_URL = 'git@github.com:afiordaliso/repasando-programacion.git'
        BRANCH_NAME = 'dev_fiorda'
        BRANCH_PROD = 'produccion'
    }

    tools {
        maven "MAVEN_HOME"
    }

    triggers {
        githubPush()  // Activado con push en GitHub
    }

    stages {
        stage('Detectar PR') {
            steps {
                script {
                    // Intentar detectar el PR automáticamente
                    env.PR_NUMBER = env.CHANGE_ID

                    // Si no se detecta, intentar obtenerlo manualmente desde git log
                    if (!env.PR_NUMBER?.trim()) {
                        env.PR_NUMBER = sh(
                            script: "git log --merges --oneline | grep -oE '#[0-9]+' | head -1 | tr -d '#'",
                            returnStdout: true
                        ).trim()
                    }

                    // Si aún no se encuentra, cancelar el pipeline
                    if (!env.PR_NUMBER?.trim()) {
                        error("🚨 ERROR: No se pudo detectar el Pull Request. Cancelando ejecución.")
                    } else {
                        echo "✅ PR detectado: #${env.PR_NUMBER}"
                    }
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "${BRANCH_NAME}"]],
                    userRemoteConfigs: [[
                        url: "${REPO_URL}",
                        credentialsId: 'github-ssh'
                    ]]
                ])
                sh 'git fetch --all'
            }
        }

        stage('Construcción') {
            steps {
                echo "Construyendo el proyecto con Maven"
                sh "mvn clean package -DskipTests"
            }
        }

        stage('Pruebas') {
            steps {
                echo "Ejecutando pruebas unitarias"
                timeout(time: 4, unit: 'MINUTES') {
                    sh "mvn clean install"
                }
                junit '**/target/surefire-reports/*.xml'
            }
        }

        stage('SonarQube Análisis') {
            steps {
                echo "Ejecutando análisis en SonarQube"
                withSonarQubeEnv('sonarqube') {
                    sh "mvn sonar:sonar"
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo "Verificando calidad en SonarQube"
                sleep(10)
                waitForQualityGate abortPipeline: true
            }
        }

        stage('Merge en Producción') {
            steps {
                script {
                    echo "Haciendo merge en producción"
                    sh """
                        git config --global user.email "fiordaa1@gmail.com"
                        git config --global user.name "Jenkins CI"

                        git fetch origin
                        git checkout ${BRANCH_PROD}
                        git pull origin ${BRANCH_PROD}
                        git merge origin/${BRANCH_NAME} --no-ff --commit
                        git push origin ${BRANCH_PROD}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline exitoso. Merge realizado."
        }
        failure {
            echo "❌ Pipeline fallido. No se realizó el merge."
        }
    }
}
