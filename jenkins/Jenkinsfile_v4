pipeline {
    agent any

    environment {
        REPO_URL = 'git@github.com:afiordaliso/repasando-programacion.git'
        BRANCH_NAME = 'dev_fiorda'  // Rama de desarrollo
        BRANCH_PROD = 'produccion'  // Rama de producción
    }

    tools {
        maven "MAVEN_HOME"
    }

    triggers {
        githubPush()  // Activado con push en GitHub
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "Clonando el repositorio..."
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "${BRANCH_NAME}"]],
                        userRemoteConfigs: [[
                            url: "${REPO_URL}",
                            credentialsId: 'github-ssh'
                        ]]
                    ])
                    sh 'git fetch --all'
                }
            }
        }

        stage('Construcción') {
            steps {
                echo "Construyendo el proyecto con Maven..."
                sh "mvn clean package -DskipTests"
            }
        }

        stage('Pruebas') {
            steps {
                echo "Ejecutando pruebas unitarias..."
                timeout(time: 4, unit: 'MINUTES') {
                    sh "mvn clean install"
                }
                junit '**/target/surefire-reports/*.xml'
            }
        }

        stage('SonarQube Análisis') {
            steps {
                echo "Ejecutando análisis con SonarQube..."
                withSonarQubeEnv('sonarqube') {
                    sh "mvn sonar:sonar"
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    echo "Esperando resultados de Quality Gate..."
                    sleep(10) // Esperar para que se generen los resultados en SonarQube

                    def qg = waitForQualityGate()
                    if (qg.status != 'OK') {
                        echo "❌ No pasó los Quality Gates. Descartando commit..."
                        sh 'git reset --hard HEAD~1'  // Descartar el último commit
                        error("Pipeline detenido: No pasó los Quality Gates")
                    } else {
                        echo "✅ Código aprobado por Quality Gates."
                    }
                }
            }
        }

        stage('Merge en Producción') {
            steps {
                script {
                    echo "Realizando merge en producción..."
                    sh """
                        git config --global user.email "fiordaa1@gmail.com"
                        git config --global user.name "Jenkins CI"

                        git fetch origin
                        git checkout ${BRANCH_PROD}
                        git pull origin ${BRANCH_PROD}
                        
                        git merge --no-ff origin/${BRANCH_NAME} --commit || {
                            echo "❌ Error en el merge. No se pudo fusionar los cambios."
                            exit 1
                        }

                        git push origin ${BRANCH_PROD}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline exitoso. Merge realizado correctamente."
        }
        failure {
            echo "❌ Pipeline fallido. No se realizó el merge."
        }
    }
}
