pipeline {
    agent any

    environment {
        REPO_URL = 'git@github.com:afiordaliso/repasando-programacion.git'
        BRANCH_PROD = 'produccion'  // Solo esta se mantiene fija
    }

    tools {
        maven "MAVEN_HOME"
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "📌 Ejecutando en la rama: ${env.BRANCH_NAME}"
                    if (env.BRANCH_NAME == 'dev_fiorda') {
                        echo "✅ Rama de desarrollo detectada. Continuando..."
                    } else {
                        sh "git checkout dev_fiorda"
                    }
                }
            }
        }

        stage('Build') {
            steps {
                echo "Building project with Maven"
                sh "mvn clean package -DskipTests"
            }
        }

        stage('Pruebas') {
            steps {
                echo "Running tests and generating coverage report"
                sh "mvn clean install"
                junit '**/target/surefire-reports/*.xml'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo "Running SonarQube analysis"
                withSonarQubeEnv('sonarqube') {
                    sh "mvn sonar:sonar"
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    try {
                        echo "Checking Quality Gate status"
                        sleep(10)
                        waitForQualityGate abortPipeline: true
                    } catch (Exception e) {
                        echo "❌ Quality Gate falló. Deteniendo el pipeline."
                        currentBuild.result = 'FAILURE'
                        error "Fallo en Quality Gate"
                    }
                }
            }
        }

        stage('Merge to Production') {
            when {
                expression { env.BRANCH_NAME == 'dev_fiorda' && (currentBuild.result == null || currentBuild.result == 'SUCCESS') }
            }
            steps {
                script {
                    echo "🔄 Merging branch '${env.BRANCH_NAME}' into '${BRANCH_PROD}'"
                    sh """
                        git fetch origin
                        git checkout ${BRANCH_PROD}
                        git reset --hard origin/${BRANCH_PROD}
                        git pull origin ${BRANCH_PROD}
                        git merge --no-ff origin/${env.BRANCH_NAME} || git merge --abort
                        git push origin ${BRANCH_PROD}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline exitoso. Merge realizado correctamente."
        }
        failure {
            echo "❌ Pipeline fallido. No se realizó el merge."
        }
    }
}
