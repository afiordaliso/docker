pipeline {
    agent any

    environment {
        REPO_URL = 'git@github.com:afiordaliso/repasando-programacion.git'
        BRANCH_PROD = 'produccion'  // Rama fija de producción
    }

    tools {
        maven "MAVEN_HOME"
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "📌 Ejecutando en la rama: ${env.BRANCH_NAME}"

                    // Actualizar todas las ramas
                    sh "git fetch --all"

                    // Verificar si dev_fiorda existe en remoto
                    def branchExists = sh(script: "git ls-remote --heads origin dev_fiorda", returnStatus: true) == 0

                    if (branchExists) {
                        echo "🔄 Se encontró la rama 'dev_fiorda', cambiando..."
                        sh """
                            git checkout -B dev_fiorda origin/dev_fiorda
                            git pull origin dev_fiorda
                        """
                    } else {
                        echo "⚠️ La rama 'dev_fiorda' no existe, continuando con ${env.BRANCH_NAME}"
                        sh "git pull origin ${env.BRANCH_NAME}"
                    }
                }
            }
        }

        stage('Build') {
            steps {
                echo "Building project with Maven"
                sh "mvn clean package -DskipTests"
            }
        }

        stage('Pruebas') {
            steps {
                echo "Running tests and generating coverage report"
                sh "mvn clean install"
                junit '**/target/surefire-reports/*.xml'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo "Running SonarQube analysis"
                withSonarQubeEnv('sonarqube') {
                    sh "mvn sonar:sonar"
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    try {
                        echo "Checking Quality Gate status"
                        sleep(10)
                        waitForQualityGate abortPipeline: true
                    } catch (Exception e) {
                        echo "❌ Quality Gate falló. Deteniendo el pipeline."
                        error "Fallo en Quality Gate"
                    }
                }
            }
        }

        stage('Merge to Production') {
            when {
                expression { env.BRANCH_NAME == 'dev_fiorda' && (currentBuild.result == null || currentBuild.result == 'SUCCESS') }
            }
            steps {
                script {
                    echo "🔄 Merging branch '${env.BRANCH_NAME}' into '${BRANCH_PROD}'"
                    sh """
                        git fetch origin
                        git checkout ${BRANCH_PROD}
                        git reset --hard origin/${BRANCH_PROD}
                        git pull origin ${BRANCH_PROD}
                        git merge --no-ff origin/${env.BRANCH_NAME} || (git merge --abort && exit 1)
                        git push --force-with-lease origin ${BRANCH_PROD}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline exitoso. Merge realizado correctamente."
        }
        failure {
            echo "❌ Pipeline fallido. No se realizó el merge."
        }
    }
}
