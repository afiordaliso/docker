pipeline {
    agent any

    environment {
        REPO_URL = 'git@github.com:afiordaliso/repasando-programacion.git'
        BRANCH_NAME = 'dev_fiorda'
        BRANCH_PROD = 'produccion'
    }

    tools {
        maven "MAVEN_HOME"
    }

    triggers {
        githubPush()  // Se ejecuta cuando hay un push a GitHub
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "${BRANCH_NAME}"]],
                        userRemoteConfigs: [[
                            url: "${REPO_URL}",
                            credentialsId: 'github-ssh'
                        ]]
                    ])
                    sh 'git fetch --all'
                    
                    // Guardar el commit anterior antes de los cambios
                    env.PREVIOUS_COMMIT = sh(script: "git rev-parse HEAD~1", returnStdout: true).trim()
                    echo "📝 Último commit antes del push: ${env.PREVIOUS_COMMIT}"
                }
            }
        }

        stage('Construcción') {
            steps {
                echo "🔨 Construyendo el proyecto con Maven"
                sh "mvn clean package -DskipTests"
            }
        }

        stage('Pruebas') {
            steps {
                echo "🧪 Ejecutando pruebas unitarias"
                timeout(time: 4, unit: 'MINUTES') {
                    sh "mvn clean install"
                }
                junit '**/target/surefire-reports/*.xml'
            }
        }

        stage('SonarQube Análisis') {
            steps {
                echo "📊 Ejecutando análisis en SonarQube"
                withSonarQubeEnv('sonarqube') {
                    sh "mvn sonar:sonar"
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    echo "🔍 Verificando Quality Gates en SonarQube"
                    sleep(10) // Espera para permitir el análisis
                    def qualityGateResult = waitForQualityGate()

                    if (qualityGateResult.status != 'OK') {
                        echo "❌ Quality Gate falló, descartando el commit..."
                        
                        // Volver al commit anterior y forzar el push para eliminar el commit fallido
                        sh """
                            git reset --hard ${env.PREVIOUS_COMMIT}
                            git push origin ${BRANCH_NAME} --force
                        """
                        
                        error("🚨 ERROR: Quality Gates fallaron. Commit descartado.")
                    } else {
                        echo "✅ Quality Gate aprobado, continuando con el pipeline..."
                    }
                }
            }
        }

        stage('Merge en Producción') {
            steps {
                script {
                    echo "📦 Haciendo merge en producción"
                    sh """
                        git config --global user.email "fiordaa1@gmail.com"
                        git config --global user.name "Jenkins CI"

                        git fetch origin
                        git checkout ${BRANCH_PROD}
                        git pull origin ${BRANCH_PROD}
                        git merge origin/${BRANCH_NAME} --no-ff --commit
                        git push origin ${BRANCH_PROD}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline exitoso. Merge realizado."
        }
        failure {
            echo "❌ Pipeline fallido. No se realizó el merge."
        }
    }
}
