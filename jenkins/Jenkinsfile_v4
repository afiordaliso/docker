pipeline {
    agent any

    environment {
        REPO_URL = 'git@github.com:afiordaliso/repasando-programacion.git'
        BRANCH_PROD = 'produccion'
    }

    tools {
        maven "MAVEN_HOME"
    }

    stages {
stage('Mostrar Información del Repositorio') {
    steps {
        script {
            echo "📌 Mostrando información del repositorio en el workspace de Jenkins..."
            sh """
                echo "📍 Ruta actual del workspace:"
                pwd
                echo "📂 Contenido del directorio actual:"
                ls -la
                echo "🔗 URL del repositorio remoto:"
                git config --get remote.origin.url
                echo "🌿 Rama actual:"
                git rev-parse --abbrev-ref HEAD
                echo "🕵️ Último commit:"
                git log -1 --oneline
                echo "📌 Todas las ramas disponibles:"
                git branch -a
            """
        }
    }
}


        stage('Build') {
            steps {
                echo "Building project with Maven"
                sh "mvn clean package -DskipTests"
            }
        }

        stage('Pruebas') {
            steps {
                echo "Running tests and generating coverage report"
                sh "mvn clean install"
                junit '**/target/surefire-reports/*.xml'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo "Running SonarQube analysis"
                withSonarQubeEnv('sonarqube') {
                    sh "mvn sonar:sonar"
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    try {
                        echo "Checking Quality Gate status"
                        sleep(10)
                        waitForQualityGate abortPipeline: true
                    } catch (Exception e) {
                        echo "❌ Quality Gate falló. Deteniendo el pipeline."
                        error "Fallo en Quality Gate"
                    }
                }
            }
        }

        stage('Merge to Production') {
            when {
                expression { env.BRANCH_NAME == 'dev_fiorda' && (currentBuild.result == null || currentBuild.result == 'SUCCESS') }
            }
            steps {
                script {
                    echo "🔄 Merging branch '${env.BRANCH_NAME}' into '${BRANCH_PROD}'"
                    sh """
                        git fetch origin
                        git checkout ${BRANCH_PROD}
                        git reset --hard origin/${BRANCH_PROD}
                        git pull origin ${BRANCH_PROD}
                        git merge --no-ff origin/${env.BRANCH_NAME} || (git merge --abort && exit 1)
                        git push --force-with-lease origin ${BRANCH_PROD}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline exitoso. Merge realizado correctamente."
        }
        failure {
            echo "❌ Pipeline fallido. No se realizó el merge."
        }
    }
}
