pipeline {
    agent any

    environment {
        REPO_URL = 'git@github.com:afiordaliso/repasando-programacion.git'
        BRANCH_NAME = 'dev_fiorda' // Rama de desarrollo
        BRANCH_PROD = 'produccion' // Rama de producción
        GITHUB_TOKEN = credentials('github-token') // Token de GitHub para cerrar PRs si fallan los Quality Gates
        PR_NUMBER = "" // Se llenará dinámicamente si es un PR
    }

    tools {
        maven "MAVEN_HOME"
    }

    triggers {
        githubPush() // Se ejecuta con cada push en GitHub
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    def scmVars = checkout([
                        $class: 'GitSCM',
                        branches: [[name: "${BRANCH_NAME}"]],
                        userRemoteConfigs: [[
                            url: "${REPO_URL}",
                            credentialsId: 'github-ssh'
                        ]]
                    ])
                    sh 'git fetch --all'

                    // Si es un pull request, extraer el número de PR
                    if (env.CHANGE_ID) {
                        PR_NUMBER = env.CHANGE_ID
                        echo "Este pipeline fue activado por el Pull Request #${PR_NUMBER}"
                    }
                }
            }
        }

        stage('Build') {
            steps {
                echo "Building project with Maven"
                sh "mvn clean package -DskipTests"
            }
        }

        stage('Pruebas') {
            steps {
                echo "Running tests and generating coverage report"
                timeout(time: 4, unit: 'MINUTES') {
                    sh "mvn clean install"
                }
                junit '**/target/surefire-reports/*.xml'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo "Running SonarQube analysis"
                withSonarQubeEnv('sonarqube') {
                    sh "mvn sonar:sonar"
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo "Checking Quality Gate status"
                sleep(10) // Espera para que SonarQube genere resultados
                script {
                    def qualityGate = waitForQualityGate()
                    if (qualityGate.status != 'OK') {
                        echo "❌ Quality Gate falló. No se permitirá el merge."
                        if (PR_NUMBER) {
                            echo "Cerrando Pull Request #${PR_NUMBER} en GitHub..."
                            sh """
                                curl -X PATCH -H "Authorization: token ${GITHUB_TOKEN}" \
                                -H "Accept: application/vnd.github.v3+json" \
                                https://api.github.com/repos/afiordaliso/repasando-programacion/pulls/${PR_NUMBER} \
                                -d '{"state": "closed"}'
                            """
                        }
                        error("Pipeline detenido porque falló el Quality Gate.")
                    }
                }
            }
        }

        stage('Merge to Production') {
            when {
                expression { env.PR_NUMBER == null } // Solo permite merge si no es un PR
            }
            steps {
                script {
                    echo "Merging to production branch"
                    sh """
                        git config --global user.email "fiordaa1@gmail.com"
                        git config --global user.name "Jenkins CI"

                        git fetch origin
                        git checkout ${BRANCH_PROD}
                        git pull origin ${BRANCH_PROD}
                        git merge origin/${BRANCH_NAME} --no-ff --commit
                        git push origin ${BRANCH_PROD}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline exitoso. Merge realizado."
        }
        failure {
            echo "❌ Pipeline fallido. No se realizó el merge."
        }
    }
}
