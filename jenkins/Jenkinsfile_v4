pipeline {
    agent any

    environment {
        REPO_URL = 'git@github.com:afiordaliso/repasando-programacion.git'
        BRANCH_PROD = 'produccion'  // Rama a la que se hará merge tras pasar Quality Gate
    }

    tools {
        maven "MAVEN_HOME"
    }

    triggers {
        githubPush()  // Activado con push en GitHub
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/produccion']],
                    userRemoteConfigs: [[
                        credentialsId: 'github-ssh',
                        url: 'git@github.com:afiordaliso/repasando-programacion.git'
                    ]]
                ])
            }
        }

        stage('Build') {
            steps {
                echo "Building project with Maven"
                sh "mvn clean package -DskipTests"
            }
        }

        stage('Pruebas') {
            steps {
                echo "Running tests and generating coverage report"
                sh "mvn clean install"
                junit '**/target/surefire-reports/*.xml'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo "Running SonarQube analysis"
                withSonarQubeEnv('sonarqube') {
                    sh "mvn sonar:sonar"
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo "Checking Quality Gate status"
                sleep(10) // Da tiempo a que se procese el análisis en SonarQube
                waitForQualityGate abortPipeline: true
            }
        }

        stage('Merge to Production') {
            steps {
                script {
                    echo "Merging branch '${env.BRANCH_NAME}' into '${BRANCH_PROD}'"
                    sh """
                        git fetch origin
                        git checkout ${BRANCH_PROD}
                        git pull origin ${BRANCH_PROD}
                        git reset --hard origin/${env.BRANCH_NAME}  # Asegurar estado limpio
                        git merge --no-ff origin/${env.BRANCH_NAME}  # Merge seguro
                        git push --force-with-lease origin ${BRANCH_PROD}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline exitoso. Merge realizado correctamente."
        }
        failure {
            echo "❌ Pipeline fallido. No se realizó el merge."
        }
    }
}
