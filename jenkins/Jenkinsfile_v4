pipeline {
    agent any

    environment {
        REPO_URL = 'git@github.com:afiordaliso/repasando-programacion.git'
        BRANCH_NAME = 'dev_fiorda' // Usa el nombre de la rama detectada por Jenkins
        BRANCH_PROD = 'produccion'
    }

    tools {
        maven "MAVEN_HOME"
    }

    triggers {
        githubPush()  // Activado con push en GitHub
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "${BRANCH_NAME}"]], // Busca la rama exacta
                    userRemoteConfigs: [[
                        url: "${REPO_URL}",
                        credentialsId: 'github-ssh' // Aquí va la credencial SSH configurada
                    ]]
                ])
                sh 'git fetch --all' // Sincroniza todas las ramas remotas
            }
        }

        stage('Construccion') {
            steps {
                echo "Construye el proyecto con Maven"
                sh "mvn clean package -DskipTests"
            }
        }

        stage('Pruebas') {
            steps {
                echo "Ejecuta las pruebas unitarias"
                timeout(time: 4, unit: 'MINUTES') {
                    sh "mvn clean install"
                }
                junit '**/target/surefire-reports/*.xml'
            }
        }

        stage('SonarQube Analisis') {
            steps {
                echo "Running SonarQube analysis"
                withSonarQubeEnv('sonarqube') {
                    sh "mvn sonar:sonar"
                }
            }
        }

        stage('Quality Gate') {
            steps {
                echo "Checking Quality Gate status"
                sleep(10) // Para darle tiempo a que se genere el resultado en SonarQube
                waitForQualityGate abortPipeline: true
            }
        }

stage('Merge en Producción') {
    steps {
        script {
            echo "Merge en Producción"
            sh """
                git config --global user.email "fiordaa1@gmail.com"
                git config --global user.name "Jenkins CI"

                git fetch origin
                git checkout ${BRANCH_PROD}
                git pull origin ${BRANCH_PROD}
                git merge origin/${BRANCH_NAME} --no-ff --commit
                git push origin ${BRANCH_PROD}
            """
        }
    }
}
    }

    post {
        success {
            echo "Pipeline exitoso. Merge realizado."
        }
        failure {
            echo "Pipeline fallido. No se realizó el merge."
        }
    }
}