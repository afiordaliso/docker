pipeline {
    agent any

    tools {
        maven "MAVEN_HOME"
    }

    triggers {
        githubPush()  // Activado con push en GitHub
    }

    environment {
        REPO_URL = 'https://github.com/afiordaliso/repasando-programacion.git'
        BRANCH_NAME = 'dev_fiorda'
    }

    stages {
        stage('Clone') {
            steps {
                timeout(time: 4, unit: 'MINUTES') {
                    cleanWs()
                    git branch: "${BRANCH_NAME}", url: "${REPO_URL}"
                }
            }
        }
        stage('Build') {
            steps {
                echo "Building project with Maven"
                timeout(time: 4, unit: 'MINUTES') {
                    sh "mvn -DskipTests clean package"
                }
            }
        }
        stage('Test') {
            steps {
                echo "Running tests and generating coverage report"
                timeout(time: 4, unit: 'MINUTES') {
                    sh "mvn clean install"
                }
                junit '**/target/surefire-reports/*.xml'
            }
        }
        stage('Sonar') {
            steps {
                echo "Analyzing code with SonarQube"
                timeout(time: 4, unit: 'MINUTES') {
                    withSonarQubeEnv('sonarqube') {
                        sh "mvn sonar:sonar"
                    }
                }
            }
        }
        stage('Quality Gate') {
            steps {
                echo "Checking quality gate status"
                sleep(10)
                timeout(time: 4, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        success {
            echo "El código pasó los estándares de calidad."
            script {
                // Si pasa el Quality Gate, se hace el merge a la rama producción
                sh """
                    git fetch origin
                    git checkout produccion
                    git merge ${BRANCH_NAME}
                    git push origin produccion
                """
            }
        }
        failure {
            echo "El código no pasó los estándares de calidad."
            error "Pipeline fallido debido a los Quality Gates."
        }
    }
}
